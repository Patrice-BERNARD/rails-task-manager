<div class="container mx-3 my-3">
<h1>Toutes mes tâches.</h1>
<ul>
<% @tasks.each do |task| %>
<li ><% if task.completed == true %>
<i class="fa-regular fa-square-check"></i>
<% else %>
<i class="fa-regular fa-square"></i>
<% end %>
  <%= link_to task.title, task_path(task) %>
<%= link_to " ",
  task_path(task.id), class:"fa-regular fa-trash-can", title:"Supprimer #{task.title}",
  data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} %></li>
<% end %>
</ul>
<button class="btn btn-outline-warning"> <%= link_to "New task", new_task_path, class:"link-underline link-underline-opacity-0" %></button>

</div>
